{
 "doctype": "Print Format",
 "name": "Weight Receipt",
 "doc_type": "POS Order",
 "module": "Scrap Metal Suite",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "default_print_language": "en",
 "disabled": 0,
 "html": "<style>\n    @page {\n        size: A4;\n        margin: 10mm;\n    }\n\n    .weight-receipt {\n        font-family: Arial, sans-serif;\n        font-size: 11pt;\n        color: #333;\n        max-width: 800px;\n        margin: 0 auto;\n    }\n\n    /* Header Section */\n    .receipt-header {\n        display: flex;\n        justify-content: space-between;\n        align-items: flex-start;\n        padding-bottom: 10px;\n        border-bottom: 2px solid #333;\n    }\n\n    .company-logo {\n        width: 120px;\n        height: auto;\n    }\n\n    .company-logo img {\n        max-width: 100%;\n        max-height: 80px;\n    }\n\n    .qr-code {\n        width: 80px;\n        height: 80px;\n    }\n\n    .qr-code img {\n        width: 100%;\n        height: 100%;\n    }\n\n    /* Sub-header / Address */\n    .company-address {\n        text-align: center;\n        padding: 8px 0;\n        font-size: 10pt;\n        color: #555;\n        border-bottom: 1px solid #ddd;\n    }\n\n    /* Title */\n    .receipt-title {\n        text-align: center;\n        font-size: 18pt;\n        font-weight: bold;\n        margin: 15px 0 10px 0;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n    }\n\n    /* Order Info Section */\n    .order-info {\n        display: flex;\n        flex-wrap: wrap;\n        padding: 10px 0;\n        border-bottom: 1px solid #ddd;\n    }\n\n    .info-row {\n        width: 50%;\n        padding: 4px 0;\n        display: flex;\n    }\n\n    .info-label {\n        font-weight: bold;\n        width: 120px;\n        color: #555;\n    }\n\n    .info-value {\n        flex: 1;\n    }\n\n    /* Tables */\n    .items-section {\n        margin: 15px 0;\n    }\n\n    .section-title {\n        font-size: 12pt;\n        font-weight: bold;\n        padding: 8px 0;\n        margin-bottom: 0;\n        border-bottom: 2px solid #333;\n    }\n\n    .items-table {\n        width: 100%;\n        border-collapse: collapse;\n        margin-bottom: 15px;\n    }\n\n    .items-table th {\n        padding: 8px 5px;\n        text-align: left;\n        border-bottom: 1px solid #ddd;\n        font-weight: bold;\n        color: #555;\n    }\n\n    .items-table td {\n        padding: 6px 5px;\n        border-bottom: 1px solid #eee;\n    }\n\n    .items-table .text-right {\n        text-align: right;\n    }\n\n    .items-table .total-row {\n        font-weight: bold;\n        border-top: 1px solid #333;\n    }\n\n    .items-table .total-row td {\n        padding-top: 10px;\n        border-bottom: none;\n    }\n\n    /* Truck Weight Section */\n    .truck-weight-section {\n        margin: 15px 0;\n        padding: 10px 0;\n    }\n\n    .truck-weight-title {\n        font-size: 12pt;\n        font-weight: bold;\n        margin-bottom: 10px;\n        padding-bottom: 5px;\n        border-bottom: 2px solid #333;\n    }\n\n    .weight-grid {\n        display: flex;\n        flex-wrap: wrap;\n    }\n\n    .weight-item {\n        width: 50%;\n        padding: 5px 0;\n        display: flex;\n    }\n\n    .weight-label {\n        width: 140px;\n        color: #555;\n    }\n\n    .weight-value {\n        font-weight: bold;\n    }\n\n    .weight-time {\n        color: #777;\n        font-size: 9pt;\n        margin-left: 10px;\n    }\n\n    .weight-divider {\n        width: 100%;\n        border-top: 1px dashed #ccc;\n        margin: 8px 0;\n    }\n\n    .variance-section {\n        margin-top: 10px;\n        padding-top: 10px;\n        border-top: 1px solid #ddd;\n    }\n\n    .variance-ok {\n        color: #28a745;\n    }\n\n    .variance-warning {\n        color: #dc3545;\n    }\n\n    /* Status Section */\n    .status-section {\n        margin: 15px 0;\n        padding: 10px 0;\n        border-top: 1px solid #ddd;\n        display: flex;\n        justify-content: space-between;\n        align-items: center;\n    }\n\n    .status-badge {\n        display: inline-block;\n        padding: 5px 15px;\n        border-radius: 3px;\n        font-weight: bold;\n        text-transform: uppercase;\n    }\n\n    .status-pending {\n        background-color: #fff3cd;\n        color: #856404;\n    }\n\n    .status-processed {\n        background-color: #d4edda;\n        color: #155724;\n    }\n\n    .status-cancelled {\n        background-color: #f8d7da;\n        color: #721c24;\n    }\n\n    /* Notes Section */\n    .notes-section {\n        margin: 15px 0;\n        padding: 10px 0;\n        min-height: 30px;\n    }\n\n    .notes-title {\n        font-weight: bold;\n        margin-bottom: 5px;\n    }\n\n    /* Signatures */\n    .signatures-section {\n        margin-top: 30px;\n        display: flex;\n        justify-content: space-between;\n    }\n\n    .signature-box {\n        width: 45%;\n        text-align: center;\n    }\n\n    .signature-line {\n        border-top: 1px solid #333;\n        margin-top: 50px;\n        padding-top: 5px;\n    }\n\n    /* Reweight flags */\n    .reweight-flags {\n        margin: 10px 0;\n        padding: 8px;\n        background-color: #fff3cd;\n        border: 1px solid #ffc107;\n        font-size: 10pt;\n    }\n\n    .reweight-flag {\n        display: inline-block;\n        margin-right: 15px;\n    }\n</style>\n\n<div class=\"weight-receipt\">\n    <!-- Header: Logo left, QR right -->\n    <div class=\"receipt-header\">\n        <div class=\"company-logo\">\n            {% set company_name = frappe.db.get_default(\"Company\") %}\n            {% set company = frappe.get_doc(\"Company\", company_name) if company_name else None %}\n            {% if company.company_logo %}\n                <img src=\"{{ company.company_logo }}\" alt=\"Company Logo\">\n            {% else %}\n                <strong>{{ company.company_name or \"Scrap Metal Trading\" }}</strong>\n            {% endif %}\n        </div>\n        <div class=\"qr-code\">\n            <img src=\"{{ qr_src(doc.doctype, doc.name) }}\" alt=\"QR Code\">\n        </div>\n    </div>\n\n    <!-- Sub-header: Company Address -->\n    <div class=\"company-address\">\n        {% if company %}\n            {{ company.address_line1 or \"\" }}\n            {% if company.address_line2 %}, {{ company.address_line2 }}{% endif %}\n            {% if company.city %}, {{ company.city }}{% endif %}\n            {% if company.state %}, {{ company.state }}{% endif %}\n            {% if company.pincode %} {{ company.pincode }}{% endif %}\n            {% if company.phone %}<br>Tel: {{ company.phone }}{% endif %}\n        {% endif %}\n    </div>\n\n    <!-- Title -->\n    <div class=\"receipt-title\">Weight Receipt</div>\n\n    <!-- Order Information -->\n    <div class=\"order-info\">\n        <div class=\"info-row\">\n            <span class=\"info-label\">Order ID:</span>\n            <span class=\"info-value\">{{ doc.order_id or doc.name }}</span>\n        </div>\n        <div class=\"info-row\">\n            <span class=\"info-label\">Order Date:</span>\n            <span class=\"info-value\">{{ frappe.utils.formatdate(doc.order_date, \"dd/MM/yyyy\") }}</span>\n        </div>\n        <div class=\"info-row\">\n            <span class=\"info-label\">Supplier:</span>\n            <span class=\"info-value\">{{ doc.supplier }}</span>\n        </div>\n        <div class=\"info-row\">\n            <span class=\"info-label\">Drop-off Date:</span>\n            <span class=\"info-value\">{{ frappe.utils.formatdate(doc.dropoff_date, \"dd/MM/yyyy\") }}</span>\n        </div>\n        <div class=\"info-row\">\n            <span class=\"info-label\">Supplier Name:</span>\n            <span class=\"info-value\">{{ doc.supplier_name or \"\" }}</span>\n        </div>\n        <div class=\"info-row\">\n            <span class=\"info-label\">License Plate:</span>\n            <span class=\"info-value\">{{ doc.license_plate or \"-\" }}</span>\n        </div>\n    </div>\n\n    <!-- Order Items (Indicated) -->\n    {% if doc.order_items %}\n    <div class=\"items-section\">\n        <div class=\"section-title\">Order Items (Indicated)</div>\n        <table class=\"items-table\">\n            <thead>\n                <tr>\n                    <th style=\"width: 10%\">#</th>\n                    <th style=\"width: 50%\">Item</th>\n                    <th style=\"width: 20%\">Unit</th>\n                    <th style=\"width: 20%\" class=\"text-right\">Weight (kg)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set order_total = namespace(value=0) %}\n                {% for item in doc.order_items %}\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ item.item_name or item.item_code }}</td>\n                    <td>{{ item.uom or \"Kg\" }}</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(item.weight or 0) }}</td>\n                </tr>\n                {% set order_total.value = order_total.value + (item.weight or 0) %}\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"3\" class=\"text-right\">Total Indicated:</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(order_total.value) }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    <!-- Weighed Items (Actual) -->\n    {% if doc.items %}\n    <div class=\"items-section\">\n        <div class=\"section-title\">Weighed Items (Actual)</div>\n        <table class=\"items-table\">\n            <thead>\n                <tr>\n                    <th style=\"width: 10%\">#</th>\n                    <th style=\"width: 35%\">Item</th>\n                    <th style=\"width: 20%\">Unit</th>\n                    <th style=\"width: 20%\" class=\"text-right\">Weight (kg)</th>\n                    <th style=\"width: 15%\">Ref</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ item.item_name or item.item_code }}</td>\n                    <td>{{ item.uom or \"Kg\" }}</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(item.weight or 0) }}</td>\n                    <td>{{ item.scrap_weight or \"\" }}</td>\n                </tr>\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"3\" class=\"text-right\">Total Weighed:</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(doc.total_scrap_weight or 0) }}</td>\n                    <td></td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    <!-- Truck Weight Verification -->\n    <div class=\"truck-weight-section\">\n        <div class=\"truck-weight-title\">Truck Weight Verification</div>\n        <div class=\"weight-grid\">\n            <div class=\"weight-item\">\n                <span class=\"weight-label\">Gross Weight:</span>\n                <span class=\"weight-value\">{{ \"{:,.2f}\".format(doc.gross_weight or 0) }} kg</span>\n                {% if doc.gross_weight_time %}\n                <span class=\"weight-time\">@ {{ frappe.utils.format_datetime(doc.gross_weight_time, \"HH:mm\") }}</span>\n                {% endif %}\n            </div>\n            <div class=\"weight-item\">\n                <span class=\"weight-label\">Scale:</span>\n                <span class=\"weight-value\">{{ doc.gross_weight_scale or \"-\" }}</span>\n            </div>\n            <div class=\"weight-item\">\n                <span class=\"weight-label\">Tare Weight:</span>\n                <span class=\"weight-value\">{{ \"{:,.2f}\".format(doc.tare_weight or 0) }} kg</span>\n                {% if doc.tare_weight_time %}\n                <span class=\"weight-time\">@ {{ frappe.utils.format_datetime(doc.tare_weight_time, \"HH:mm\") }}</span>\n                {% endif %}\n            </div>\n            <div class=\"weight-item\">\n                <span class=\"weight-label\">Scale:</span>\n                <span class=\"weight-value\">{{ doc.tare_weight_scale or \"-\" }}</span>\n            </div>\n        </div>\n\n        <div class=\"weight-divider\"></div>\n\n        <div class=\"weight-grid\">\n            <div class=\"weight-item\">\n                <span class=\"weight-label\">Net Truck Weight:</span>\n                <span class=\"weight-value\">{{ \"{:,.2f}\".format(doc.net_truck_weight or 0) }} kg</span>\n            </div>\n            <div class=\"weight-item\">\n                <span class=\"weight-label\">Total Scrap Weight:</span>\n                <span class=\"weight-value\">{{ \"{:,.2f}\".format(doc.total_scrap_weight or 0) }} kg</span>\n            </div>\n        </div>\n\n        <div class=\"variance-section\">\n            <div class=\"weight-grid\">\n                <div class=\"weight-item\">\n                    <span class=\"weight-label\">Variance:</span>\n                    {% set variance_class = \"variance-ok\" if (doc.weight_variance_percent or 0)|abs <= 2 else \"variance-warning\" %}\n                    <span class=\"weight-value {{ variance_class }}\">\n                        {{ \"{:,.2f}\".format(doc.weight_variance or 0) }} kg\n                        ({{ \"{:.2f}\".format(doc.weight_variance_percent or 0) }}%)\n                    </span>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Reweight Flags -->\n    {% if doc.is_truck_reweighed or doc.is_scrap_reweighed %}\n    <div class=\"reweight-flags\">\n        {% if doc.is_truck_reweighed %}\n        <span class=\"reweight-flag\">* Truck was reweighed</span>\n        {% endif %}\n        {% if doc.is_scrap_reweighed %}\n        <span class=\"reweight-flag\">* Scrap was reweighed</span>\n        {% endif %}\n    </div>\n    {% endif %}\n\n    <!-- Status Section -->\n    <div class=\"status-section\">\n        <div>\n            <strong>Status:</strong>\n            <span class=\"status-badge status-{{ (doc.status or 'pending')|lower }}\">\n                {{ doc.status or \"Pending\" }}\n            </span>\n        </div>\n        <div>\n            {% if doc.processed_time %}\n            <strong>Processed:</strong> {{ frappe.utils.format_datetime(doc.processed_time, \"dd/MM/yyyy HH:mm\") }}\n            {% endif %}\n            {% if doc.processed_by %}\n            <br><strong>Operator:</strong> {{ frappe.db.get_value(\"User\", doc.processed_by, \"full_name\") or doc.processed_by }}\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- Notes Section -->\n    {% if doc.notes or doc.truck_weight_remarks %}\n    <div class=\"notes-section\">\n        <div class=\"notes-title\">Notes:</div>\n        {% if doc.notes %}\n        <div>{{ doc.notes }}</div>\n        {% endif %}\n        {% if doc.truck_weight_remarks %}\n        <div><em>Truck remarks: {{ doc.truck_weight_remarks }}</em></div>\n        {% endif %}\n    </div>\n    {% endif %}\n\n    <!-- Signatures -->\n    <div class=\"signatures-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Supplier Signature</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">Operator Signature</div>\n        </div>\n    </div>\n</div>"
}
