 "doctype": "Print Format",
 "html": "\n<style>\n    @page { size: A4; margin: 12mm; }\n    .gate-ticket {\n        /* Thai first: the system fonts were only installed on 2 Sep, and before\n           that every Thai glyph printed as an empty box. */\n        font-family: \"Noto Sans Thai\", \"Loma\", \"Tlwg Typo\", Arial, sans-serif;\n        font-size: 11pt; color: #1a1a1a; max-width: 800px; margin: 0 auto;\n    }\n    .gt-head { display: flex; justify-content: space-between;\n        align-items: flex-start; border-bottom: 2px solid #1a1a1a; padding-bottom: 8px; }\n    .gt-title { font-size: 18pt; font-weight: 700; margin: 0; }\n    .gt-sub { font-size: 9pt; color: #666; margin: 2px 0 0; letter-spacing: .04em; }\n    .gt-no { text-align: right; }\n    .gt-no .lbl { font-size: 8pt; color: #666; text-transform: uppercase; letter-spacing: .1em; }\n    .gt-no .val { font-size: 14pt; font-weight: 700; font-variant-numeric: tabular-nums; }\n\n    .gt-grid { display: flex; gap: 24px; margin: 14px 0 4px; }\n    .gt-grid > div { flex: 1; }\n    dl { margin: 0; }\n    dt { font-size: 8pt; color: #666; text-transform: uppercase;\n         letter-spacing: .08em; margin-top: 8px; }\n    dd { margin: 1px 0 0; font-size: 11pt; font-weight: 600; }\n\n    table { width: 100%; border-collapse: collapse; margin: 10px 0; font-size: 10.5pt; }\n    th, td { padding: 6px 8px; border-bottom: 1px solid #ddd; text-align: left; }\n    thead th { background: #f2f2f2; font-size: 8.5pt; text-transform: uppercase;\n               letter-spacing: .06em; color: #555; font-weight: 600; }\n    td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }\n    tfoot td { font-weight: 700; border-top: 2px solid #1a1a1a; border-bottom: none; }\n\n    .gt-sec { font-size: 8.5pt; text-transform: uppercase; letter-spacing: .1em;\n              color: #666; margin: 16px 0 2px; border-bottom: 1px solid #ddd; padding-bottom: 3px; }\n    .gt-net { background: #f2f2f2; padding: 10px 12px; margin-top: 6px;\n              display: flex; justify-content: space-between; align-items: baseline; }\n    .gt-net .k { font-size: 9pt; text-transform: uppercase; letter-spacing: .08em; color: #555; }\n    .gt-net .v { font-size: 17pt; font-weight: 700; font-variant-numeric: tabular-nums; }\n\n    .gt-flag { margin-top: 8px; padding: 8px 10px; border-left: 3px solid #a3651d;\n               background: #fbf3e8; font-size: 10pt; }\n\n    .gt-sign { display: flex; gap: 40px; margin-top: 34px; }\n    .gt-sign > div { flex: 1; }\n    .gt-line { border-top: 1px solid #1a1a1a; margin-top: 40px; padding-top: 4px;\n               font-size: 9pt; color: #555; }\n    .gt-foot { margin-top: 16px; font-size: 8pt; color: #888; text-align: center;\n               border-top: 1px solid #eee; padding-top: 6px; }\n</style>\n\n<div class=\"gate-ticket\">\n\n    <div class=\"gt-head\">\n        <div>\n            <p class=\"gt-title\">ใบชั่งน้ำหนักขาออก</p>\n            <p class=\"gt-sub\">OUTBOUND WEIGHING TICKET</p>\n        </div>\n        <div class=\"gt-no\">\n            <div class=\"lbl\">เลขที่ / No.</div>\n            <div class=\"val\">{{ doc.name }}</div>\n        </div>\n    </div>\n\n    <div class=\"gt-grid\">\n        <div>\n            <dl>\n                <dt>ลูกค้า / Customer</dt>\n                <dd>{{ doc.customer_name or doc.customer }}</dd>\n                <dt>ทะเบียนรถ / License Plate</dt>\n                <dd>{{ doc.license_plate or \"-\" }}</dd>\n            </dl>\n        </div>\n        <div>\n            <dl>\n                <dt>พนักงานขับรถ / Driver</dt>\n                <dd>{{ doc.driver_name or \"-\" }}</dd>\n                <dt>เลขบัตรประชาชน / Driver ID</dt>\n                <dd>{{ doc.driver_id or \"-\" }}</dd>\n            </dl>\n        </div>\n    </div>\n\n    <div class=\"gt-sec\">รายการสินค้า / Items</div>\n    <table>\n        <thead>\n            <tr>\n                <th style=\"width:14%\">รหัส</th>\n                <th>รายการ / Item</th>\n                <th class=\"num\" style=\"width:22%\">น้ำหนักตกลง / Agreed (kg)</th>\n            </tr>\n        </thead>\n        <tbody>\n        {% for r in doc.items %}\n            <tr>\n                <td>{{ r.item_code }}</td>\n                <td>{{ r.item_name or r.item_code }}</td>\n                <td class=\"num\">{{ \"{:,.0f}\".format(r.qty or 0) }}</td>\n            </tr>\n        {% endfor %}\n        </tbody>\n        <tfoot>\n            <tr>\n                <td colspan=\"2\">รวม / Total agreed</td>\n                <td class=\"num\">{{ \"{:,.0f}\".format(doc.total_agreed_weight or 0) }}</td>\n            </tr>\n        </tfoot>\n    </table>\n\n    <div class=\"gt-sec\">การชั่งน้ำหนัก / Weighing</div>\n    <table>\n        <tbody>\n            <tr>\n                <td style=\"width:46%\">น้ำหนักรถเปล่า (ขาเข้า) / Tare, empty on arrival</td>\n                <td style=\"width:28%\">{{ frappe.utils.format_datetime(doc.tare_weight_time) if doc.tare_weight_time else \"-\" }}</td>\n                <td class=\"num\">{{ \"{:,.0f}\".format(doc.tare_weight or 0) }} kg</td>\n            </tr>\n            <tr>\n                <td>น้ำหนักรถบรรทุก (ขาออก) / Gross, loaded on departure</td>\n                <td>{{ frappe.utils.format_datetime(doc.gross_weight_time) if doc.gross_weight_time else \"-\" }}</td>\n                <td class=\"num\">{{ \"{:,.0f}\".format(doc.gross_weight or 0) }} kg</td>\n            </tr>\n        </tbody>\n    </table>\n\n    <div class=\"gt-net\">\n        <span class=\"k\">น้ำหนักสินค้าที่นำออก / Net weight leaving site</span>\n        <span class=\"v\">{{ \"{:,.0f}\".format(doc.net_weight or 0) }} kg</span>\n    </div>\n\n    {% if doc.verification_status == \"Needs Review\" %}\n    <div class=\"gt-flag\">\n        <strong>ตรวจสอบ / For review:</strong>\n        น้ำหนักชั่งจริงต่างจากน้ำหนักที่ตกลงไว้\n        {{ \"{:.2f}\".format(doc.weight_variance_percent or 0) }}%\n        (measured {{ \"{:,.0f}\".format(doc.net_weight or 0) }} kg vs agreed\n        {{ \"{:,.0f}\".format(doc.total_agreed_weight or 0) }} kg).\n    </div>\n    {% endif %}\n\n    <div class=\"gt-sign\">\n        <div>\n            <div class=\"gt-line\">ผู้ขับรถ / Driver</div>\n        </div>\n        <div>\n            <div class=\"gt-line\">เจ้าหน้าที่ชั่ง / Weighbridge operator</div>\n        </div>\n        <div>\n            <div class=\"gt-line\">เจ้าหน้าที่รักษาความปลอดภัย / Gate</div>\n        </div>\n    </div>\n\n    <div class=\"gt-foot\">\n        เอกสารนี้เป็นใบชั่งน้ำหนัก ไม่ใช่ใบกำกับภาษี &middot;\n        This is a weighing ticket, not a tax invoice &middot;\n        {{ frappe.utils.format_datetime(frappe.utils.now()) }}\n    </div>\n\n</div>\n",
 "idx": 0,
 "line_breaks": 0,
 "modified": "2026-09-03 13:00:00.000000",
