{
 "creation": "2026-09-03 13:00:00.000000",
 "default_print_language": "th",
 "disabled": 0,
 "doc_type": "Pickup",
 "docstatus": 0,
 "doctype": "Print Format",
 "html": "<style>\n@page {\n    size: A4;\n    margin: 15mm;\n}\n\n/* Letterhead styling - logo left, address right */\n.letter-head-wrapper {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 8mm;\n    padding-bottom: 5mm;\n    border-bottom: 1px solid #ccc;\n}\n\n.letter-head-left {\n    text-align: left;\n}\n\n.letter-head-left img {\n    max-height: 20mm;\n}\n\n.brand-name {\n    font-size: 13pt;\n    font-weight: bold;\n}\n\n.brand-name-th {\n    font-size: 11pt;\n    font-weight: bold;\n}\n\n.letter-head-right {\n    text-align: right;\n    font-size: 9pt;\n    line-height: 1.4;\n    color: #333;\n}\n\n.address-en {\n    color: #666;\n    font-size: 8pt;\n}\n\n.pickup-receipt {\n    font-family: Sarabun, Tahoma, Arial, sans-serif;\n    font-size: 10pt;\n    color: #000;\n}\n\n/* Header - split left/right */\n.doc-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-bottom: 5mm;\n    margin-bottom: 5mm;\n    border-bottom: 1px solid #000;\n}\n\n.doc-header-left {\n    text-align: left;\n}\n\n.doc-header-right {\n    text-align: right;\n}\n\n.doc-title {\n    font-size: 16pt;\n    font-weight: bold;\n}\n\n.doc-number {\n    font-size: 12pt;\n}\n\n.status-badge {\n    display: inline-block;\n    padding: 1mm 4mm;\n    margin-top: 2mm;\n    font-weight: bold;\n    font-size: 9pt;\n}\n\n.status-completed { border-bottom: 2px solid #155724; color: #155724; }\n.status-in-progress { border-bottom: 2px solid #856404; color: #856404; }\n.status-cancelled { border-bottom: 2px solid #721c24; color: #721c24; }\n.status-draft { border-bottom: 2px solid #666; color: #666; }\n.status-scheduled { border-bottom: 2px solid #004085; color: #004085; }\n\n/* Section styling - clean, no boxes */\n.section {\n    margin: 5mm 0;\n    padding-bottom: 3mm;\n    border-bottom: 1px dotted #ccc;\n}\n\n.section:last-of-type {\n    border-bottom: none;\n}\n\n.section-header {\n    font-weight: bold;\n    font-size: 11pt;\n    margin-bottom: 3mm;\n    color: #333;\n}\n\n/* Info rows - clean inline */\n.info-row {\n    display: flex;\n    padding: 1mm 0;\n}\n\n.info-label {\n    width: 35%;\n    color: #666;\n    font-size: 9pt;\n}\n\n.info-value {\n    width: 65%;\n    font-weight: 500;\n}\n\n.info-grid {\n    display: flex;\n    flex-wrap: wrap;\n}\n\n.info-grid .info-row {\n    width: 50%;\n}\n\n/* Tables - minimal styling */\n.data-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 9pt;\n    margin: 2mm 0;\n}\n\n.data-table th {\n    text-align: left;\n    padding: 2mm 3mm;\n    border-bottom: 1px solid #000;\n    font-weight: bold;\n    font-size: 8pt;\n    color: #333;\n}\n\n.data-table td {\n    padding: 2mm 3mm;\n    border-bottom: 1px dotted #ddd;\n}\n\n.data-table tr:last-child td {\n    border-bottom: none;\n}\n\n.data-table .text-right {\n    text-align: right;\n}\n\n.data-table .total-row {\n    font-weight: bold;\n    border-top: 1px solid #000;\n    border-bottom: none;\n}\n\n.data-table .total-row td {\n    padding-top: 3mm;\n    border-bottom: none;\n}\n\n/* Variance colors */\n.variance-ok {\n    color: #155724;\n}\n\n.variance-warning {\n    color: #721c24;\n}\n\n/* Review notice - same treatment the delivery slip gives a reweigh */\n.review-notice {\n    background: #fff3cd;\n    padding: 2mm 4mm;\n    margin: 3mm 0;\n    font-size: 9pt;\n    border-left: 3px solid #ffc107;\n}\n\n/* Signatures. A gate ticket needs a third hand on it - the guard who lets the\n   truck out - so the boxes are narrower than the delivery slip two. */\n.signature-section {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 15mm;\n    padding-top: 5mm;\n}\n\n.signature-box {\n    width: 40%;\n    text-align: center;\n}\n\n.signature-section.three .signature-box {\n    width: 30%;\n}\n\n.signature-line {\n    border-top: 1px solid #000;\n    margin-top: 25mm;\n    padding-top: 2mm;\n    font-size: 9pt;\n}\n\n/* Footer */\n.receipt-footer {\n    margin-top: 10mm;\n    padding-top: 3mm;\n    border-top: 1px solid #ccc;\n    font-size: 8pt;\n    color: #999;\n    display: flex;\n    justify-content: space-between;\n}\n\n.footer-disclaimer {\n    margin-top: 3mm;\n    font-size: 8pt;\n    color: #999;\n    text-align: center;\n}\n\n/* Verification summary inline */\n.verification-summary {\n    display: flex;\n    gap: 10mm;\n    margin: 3mm 0;\n}\n\n.verification-item {\n    flex: 1;\n    padding: 3mm;\n    border-left: 3px solid #ccc;\n}\n\n.verification-item.pass {\n    border-left-color: #155724;\n}\n\n.verification-item.fail {\n    border-left-color: #721c24;\n}\n\n.verification-title {\n    font-size: 8pt;\n    color: #666;\n    margin-bottom: 1mm;\n}\n\n.verification-result {\n    font-size: 11pt;\n    font-weight: bold;\n}\n</style>\n\n<!-- Letterhead with Address -->\n{#\n  Which company header to print. Chosen per print job by the  query\n  parameter, so the terminal print menu can offer SMT and MD off one format\n  instead of a duplicated template per company. Unknown or absent -> SMT.\n\n  Copied deliberately from the delivery slip rather than reworded: a driver\n  should not be able to tell from the paper which side of the trade it came\n  from, and a collection leaving the yard needs the same company header a\n  delivery arriving gets.\n#}\n{% set BRANDS = {\n    \"SMT\": {\n        \"logo\": 1,\n        \"name_en\": \"Scrap Metal Trading\",\n        \"name_th\": \"\",\n        \"addr_th\": \"88/88 ถนน บางบัวทอง – สุพรรณบุรี<br>ตำบล หน้าไม้ อำเภอลาดหลุมแก้ว<br>ปทุมธานี 12140\",\n        \"addr_en\": \"88/88 Bang Bua Thong - Suphan Buri Rd,<br>Tambon Na Mai, Lat Lum Kaeo District,<br>Pathum Thani 12140\"\n    },\n    \"MD\": {\n        \"logo\": 0,\n        \"name_en\": \"MD Recycle Group\",\n        \"name_th\": \"บริษัท เอ็มดี รีไซเคิล กรุ๊ป จำกัด\",\n        \"addr_th\": \"41/1 อาคาร 2714 ห้องเลขที่ 308-309<br>ซ.พระรามที่ 2 ซ. 54 แขวงแสมดำ<br>เขตบางขุนเทียน กรุงเทพมหานคร 10150\",\n        \"addr_en\": \"\"\n    }\n} %}\n{% set _brand_req = frappe.form_dict.get(\"brand\") or frappe.form_dict.get(\"letterhead\") %}\n{% set BRAND = BRANDS.get(_brand_req, BRANDS[\"SMT\"]) %}\n{% set _logo = (letter_head or frappe.db.get_value(\"Letter Head\", {\"is_default\": 1}, \"content\") or \"\") if BRAND.logo else \"\" %}\n<div class=\"letter-head-wrapper\">\n    <div class=\"letter-head-left\">\n        {% if _logo %}\n            {{ _logo | safe }}\n        {% else %}\n            <div class=\"brand-name\">{{ BRAND.name_en }}</div>\n            {% if BRAND.name_th %}<div class=\"brand-name-th\">{{ BRAND.name_th }}</div>{% endif %}\n        {% endif %}\n    </div>\n    <div class=\"letter-head-right\">\n        <div class=\"address-th\">{{ BRAND.addr_th | safe }}</div>\n        {% if BRAND.addr_en %}<div class=\"address-en\">{{ BRAND.addr_en | safe }}</div>{% endif %}\n    </div>\n</div>\n\n{% set truck_weights = frappe.get_all(\"Truck Weight\", filters={\"pickup\": doc.name}, fields=[\"name\", \"weight_type\", \"weight\", \"weighed_at\", \"entry_method\"]) %}\n{% set agreed = doc.total_agreed_weight or 0 %}\n{% set measured = doc.net_weight or 0 %}\n{% set variance = measured - agreed %}\n{% set variance_ok = doc.verification_status == \"Verified\" %}\n\n<div class=\"pickup-receipt\">\n    <!-- Header - Title left, Doc number right -->\n    <div class=\"doc-header\">\n        <div class=\"doc-header-left\">\n            <div class=\"doc-title\">ใบชั่งน้ำหนักขาออก / Outbound Weighing Ticket</div>\n        </div>\n        <div class=\"doc-header-right\">\n            <div class=\"doc-number\">{{ doc.name }}</div>\n            <div class=\"status-badge status-{{ doc.status|lower|replace(\" \", \"-\") }}\">{{ doc.status }}</div>\n        </div>\n    </div>\n\n    <!-- Review Notice -->\n    {% if doc.verification_status == \"Needs Review\" %}\n    <div class=\"review-notice\">\n        <strong>** ตรวจสอบ / FOR REVIEW **</strong> —\n        น้ำหนักชั่งจริงต่างจากน้ำหนักที่ตกลงไว้ {{ \"{:.2f}\".format(doc.weight_variance_percent or 0) }}%\n    </div>\n    {% endif %}\n\n    <!-- General Info -->\n    <div class=\"section\">\n        <div class=\"section-header\">ข้อมูลทั่วไป / General Information</div>\n        <div class=\"info-grid\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">วันที่นัดหมาย / Scheduled</span>\n                <span class=\"info-value\">{{ frappe.utils.format_datetime(doc.scheduled_start, \"dd/MM/yyyy HH:mm\") if doc.scheduled_start else \"-\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">ทะเบียนรถ / License Plate</span>\n                <span class=\"info-value\">{{ doc.license_plate or \"-\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">ลูกค้า / Customer</span>\n                <span class=\"info-value\">{{ doc.customer_name or doc.customer or \"-\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">สถานะตรวจสอบ / Verification</span>\n                <span class=\"info-value\">{{ doc.verification_status or \"Pending\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">พนักงานขับรถ / Driver</span>\n                <span class=\"info-value\">{{ doc.driver_name or \"-\" }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">เลขบัตรประชาชน / Driver ID</span>\n                <span class=\"info-value\">{{ doc.driver_id or \"-\" }}</span>\n            </div>\n        </div>\n    </div>\n\n    <!-- Agreed Items -->\n    {#- Most scrap grades use the Thai name as the item code, so a รหัส column\n        would just print each name twice. Shown only when a code actually carries\n        information the name does not. -#}\n    {%- set code = namespace(show=false) -%}\n    {%- for r in doc.items -%}\n        {%- if r.item_code and r.item_name and r.item_code != r.item_name -%}\n            {%- set code.show = true -%}\n        {%- endif -%}\n    {%- endfor -%}\n    <div class=\"section\">\n        <div class=\"section-header\">รายการสินค้า / Items</div>\n        <table class=\"data-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:5%\">#</th>\n                    {% if code.show %}<th style=\"width:20%\">รหัส / Code</th>{% endif %}\n                    <th>รายการ / Item</th>\n                    <th style=\"width:15%\">หน่วย / UOM</th>\n                    <th style=\"width:25%\" class=\"text-right\">น้ำหนักที่ตกลง / Agreed (kg)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for r in doc.items %}\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    {% if code.show %}<td>{{ r.item_code }}</td>{% endif %}\n                    <td>{{ r.item_name or r.item_code }}</td>\n                    <td>{{ r.uom or \"Kg\" }}</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(r.qty or 0) }}</td>\n                </tr>\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td {% if code.show %}colspan=\"4\"{% else %}colspan=\"3\"{% endif %}>รวม / Total agreed</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(agreed) }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <!-- Truck Weight. A collection arrives empty and leaves loaded, so tare is\n         the arrival weighing and gross the departure one - the mirror of the\n         delivery slip, kept in arrival-then-departure reading order. -->\n    <div class=\"section\">\n        <div class=\"section-header\">น้ำหนักรถ / Truck Weight</div>\n        <table class=\"data-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:30%\">รายการ / Item</th>\n                    <th style=\"width:25%\" class=\"text-right\">น้ำหนัก / Weight (kg)</th>\n                    <th style=\"width:25%\">เวลา / Time</th>\n                    <th style=\"width:20%\">เครื่องชั่ง / Scale</th>\n                </tr>\n            </thead>\n            <tbody>\n                <tr>\n                    <td>ขาเข้า / Tare</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(doc.tare_weight or 0) }}</td>\n                    <td>{{ frappe.utils.format_datetime(doc.tare_weight_time, \"dd/MM HH:mm\") if doc.tare_weight_time else \"-\" }}</td>\n                    <td>{{ doc.tare_weight_scale or \"-\" }}</td>\n                </tr>\n                <tr>\n                    <td>ขาออก / Gross</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(doc.gross_weight or 0) }}</td>\n                    <td>{{ frappe.utils.format_datetime(doc.gross_weight_time, \"dd/MM HH:mm\") if doc.gross_weight_time else \"-\" }}</td>\n                    <td>{{ doc.gross_weight_scale or \"-\" }}</td>\n                </tr>\n                <tr class=\"total-row\">\n                    <td>น้ำหนักสินค้าที่นำออก / Net</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(measured) }}</td>\n                    <td></td>\n                    <td></td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n\n    <!-- Weight Verification. One comparison, not the delivery two: a collection\n         has no sorted scrap to weigh against, only what was agreed. -->\n    <div class=\"section\">\n        <div class=\"section-header\">การตรวจสอบน้ำหนัก / Weight Verification</div>\n        <div class=\"verification-summary\">\n            <div class=\"verification-item {% if variance_ok %}pass{% else %}fail{% endif %}\">\n                <div class=\"verification-title\">น้ำหนักชั่งจริง vs น้ำหนักที่ตกลง<br>Measured vs Agreed</div>\n                <div class=\"verification-result {% if variance_ok %}variance-ok{% else %}variance-warning{% endif %}\">\n                    {{ \"{:,.2f}\".format(variance) }} kg ({{ \"{:.2f}\".format(doc.weight_variance_percent or 0) }}%)\n                    {% if variance_ok %}✓ ผ่าน{% elif doc.verification_status == \"Needs Review\" %}✗ ไม่ผ่าน{% endif %}\n                </div>\n                <div style=\"font-size:8pt;color:#666;margin-top:1mm;\">{{ \"{:,.2f}\".format(measured) }} vs {{ \"{:,.2f}\".format(agreed) }} kg</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Linked Records -->\n    {% if truck_weights %}\n    <div class=\"section\">\n        <div class=\"section-header\">เอกสารที่เกี่ยวข้อง / Related Documents</div>\n        <table class=\"data-table\">\n            <thead>\n                <tr>\n                    <th>ประเภท / Type</th>\n                    <th>เลขที่ / ID</th>\n                    <th class=\"text-right\">น้ำหนัก / Weight (kg)</th>\n                    <th>วันที่-เวลา / Date-Time</th>\n                    <th>วิธี / Method</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for tw in truck_weights %}\n                <tr>\n                    <td>ชั่งรถ {% if tw.weight_type == \"Tare\" %}(ขาเข้า){% else %}(ขาออก){% endif %}</td>\n                    <td>{{ tw.name }}</td>\n                    <td class=\"text-right\">{{ \"{:,.2f}\".format(tw.weight or 0) }}</td>\n                    <td>{{ frappe.utils.format_datetime(tw.weighed_at, \"dd/MM/yy HH:mm\") if tw.weighed_at else \"-\" }}</td>\n                    <td>{{ \"[A]\" if tw.entry_method == \"Scale (Auto)\" else \"[M]\" }}</td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    <!-- Remarks -->\n    {% if doc.remarks %}\n    <div class=\"section\">\n        <div class=\"section-header\">หมายเหตุ / Remarks</div>\n        <p>{{ doc.remarks }}</p>\n    </div>\n    {% endif %}\n\n    <!-- Signatures -->\n    <div class=\"signature-section three\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">ผู้ขับรถ / Driver</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">เจ้าหน้าที่ชั่ง / Weighbridge</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">เจ้าหน้าที่รักษาความปลอดภัย / Gate</div>\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"receipt-footer\">\n        <span>พิมพ์เมื่อ / Printed: {{ frappe.utils.now_datetime().strftime(\"%d/%m/%Y %H:%M\") }}</span>\n        <span>{{ frappe.session.user }}</span>\n    </div>\n    <div class=\"footer-disclaimer\">\n        เอกสารนี้เป็นใบชั่งน้ำหนัก ไม่ใช่ใบกำกับภาษี &middot; This is a weighing ticket, not a tax invoice\n    </div>\n</div>\n",
