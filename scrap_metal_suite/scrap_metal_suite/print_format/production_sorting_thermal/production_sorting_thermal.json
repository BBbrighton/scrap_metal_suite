 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n@page {\n    size: 80mm auto;\n    margin: 2mm;\n}\n\n.thermal-receipt {\n    font-family: 'Sarabun', 'Tahoma', sans-serif;\n    font-size: 12px;\n    line-height: 1.45;\n    width: 76mm;\n    margin: 0 auto;\n    padding: 2mm;\n    color: #000;\n}\n\n.receipt-header {\n    text-align: center;\n    border-bottom: 1px dashed #000;\n    padding-bottom: 3mm;\n    margin-bottom: 3mm;\n}\n\n.company-name {\n    font-size: 16px;\n    font-weight: bold;\n    margin: 2mm 0;\n}\n\n.company-address {\n    font-size: 10px;\n    margin: 1mm 0;\n}\n\n.doc-title {\n    font-size: 14px;\n    font-weight: bold;\n    margin: 2mm 0;\n}\n\n.doc-number {\n    font-size: 11px;\n    color: #000;\n}\n\n.receipt-body {\n    margin: 2mm 0;\n}\n\n.info-section {\n    border-bottom: 1px dashed #000;\n    padding-bottom: 2mm;\n    margin-bottom: 2mm;\n}\n\n.info-row {\n    display: flex;\n    justify-content: space-between;\n    margin: 1mm 0;\n    font-size: 11px;\n}\n\n.info-label {\n    color: #000;\n}\n\n.info-value {\n    font-weight: bold;\n    text-align: right;\n}\n\n.info-row-box {\n    display: flex;\n    justify-content: space-between;\n    border: 1px solid #000;\n    padding: 2mm;\n    margin: 2mm 0;\n    font-size: 10px;\n}\n\n.info-box-item {\n    text-align: center;\n}\n\n.box-label {\n    display: block;\n    font-size: 10px;\n}\n\n.box-value {\n    font-weight: bold;\n    font-size: 11px;\n}\n\n.items-section {\n    margin: 3mm 0;\n}\n\n.items-header {\n    font-weight: bold;\n    font-size: 11px;\n    border-bottom: 1px solid #000;\n    padding-bottom: 1mm;\n    margin-bottom: 1mm;\n}\n\n.item-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 1mm 0;\n    font-size: 11px;\n    border-bottom: 1px dotted #000;\n}\n\n.item-name {\n    flex: 1;\n}\n\n.item-weight {\n    text-align: right;\n    font-weight: bold;\n    min-width: 20mm;\n}\n\n.total-section {\n    border-top: 2px solid #000;\n    margin-top: 2mm;\n    padding-top: 2mm;\n}\n\n.total-row {\n    display: flex;\n    justify-content: space-between;\n    font-size: 14px;\n    font-weight: bold;\n}\n\n.total-weight {\n    font-size: 18px;\n}\n\n.reweight-badge {\n    border: 2px solid #000;\n    padding: 1mm 2mm;\n    font-size: 11px;\n    font-weight: bold;\n    text-align: center;\n    margin: 2mm 0;\n}\n\n.remarks-section {\n    border-top: 1px dashed #000;\n    margin-top: 2mm;\n    padding-top: 2mm;\n    font-size: 10px;\n}\n\n.receipt-footer {\n    border-top: 1px dashed #000;\n    margin-top: 3mm;\n    padding-top: 2mm;\n    text-align: center;\n    font-size: 10px;\n    color: #000;\n}\n\n.operator-info {\n    margin: 1mm 0;\n}\n\n.thank-you {\n    font-size: 11px;\n    font-weight: bold;\n    margin-top: 2mm;\n}\n\n.qr-section {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    margin-top: 3mm;\n    padding-top: 3mm;\n    border-top: 1px dashed #000;\n}\n\n.qr-box {\n    text-align: center;\n    margin: 2mm 0;\n}\n\n.qr-box img {\n    width: 28mm;\n    height: 28mm;\n}\n\n.qr-label {\n    font-size: 10px;\n    margin-top: 1mm;\n    font-weight: bold;\n}\n\n.qr-doc-id {\n    font-size: 9px;\n    color: #000;\n}\n\n.cut-line {\n    border-top: 1px dashed #000;\n    margin-top: 3mm;\n    text-align: center;\n    font-size: 9px;\n    color: #000;\n}\n</style>\n\n{% set plate = doc.license_plate or (frappe.db.get_value('Dropoff', doc.dropoff, 'license_plate') if doc.dropoff else None) %}\n\n<div class=\"thermal-receipt\">\n    <!-- Header -->\n    <div class=\"receipt-header\">\n        <div class=\"company-name\">Scrap Metal Trading</div>\n        <div class=\"company-address\">88/88 \u0e2b\u0e21\u0e39\u0e48 1 \u0e15.\u0e17\u0e48\u0e32\u0e44\u0e21\u0e49 \u0e2d.\u0e25\u0e32\u0e14\u0e2b\u0e25\u0e38\u0e21\u0e41\u0e01\u0e49\u0e27 \u0e08.\u0e1b\u0e17\u0e38\u0e21\u0e18\u0e32\u0e19\u0e35</div>\n        <div class=\"doc-title\">\u0e43\u0e1a\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32</div>\n        <div class=\"doc-number\">\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48: {{ doc.name }}</div>\n    </div>\n\n    <div class=\"receipt-body\">\n        <div class=\"info-section\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48:</span>\n                <span class=\"info-value\">{{ frappe.utils.formatdate(doc.sorting_date, 'dd/MM/yyyy') if doc.sorting_date else '' }}{% if doc.posting_time %} {{ doc.posting_time }}{% endif %}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">Drop-off:</span>\n                <span class=\"info-value\">{{ doc.dropoff }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19\u0e23\u0e16:</span>\n                <span class=\"info-value\">{{ plate or '-' }}</span>\n            </div>\n        </div>\n\n        <div class=\"info-section\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e1c\u0e39\u0e49\u0e02\u0e32\u0e22:</span>\n                <span class=\"info-value\">{{ doc.supplier_name or doc.supplier or '-' }}</span>\n            </div>\n        </div>\n\n        {% if doc.manager_override %}\n        <div class=\"reweight-badge\">\n            ** \u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34\u0e42\u0e14\u0e22\u0e1c\u0e39\u0e49\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23 \u2022 MANAGER OVERRIDE **\n            {% if doc.manager_override_by %}<br><span style=\"font-size:10px;font-weight:normal;\">{{ doc.manager_override_by }}</span>{% endif %}\n        </div>\n        {% endif %}\n\n        <!-- Good -->\n        {% if doc.good_items %}\n        <div class=\"items-section\">\n            <div class=\"items-header\"><span>\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e14\u0e35 \u2022 Good</span></div>\n            {% for item in doc.good_items %}\n            <div class=\"item-row\">\n                <span class=\"item-name\">{{ item.item_name or item.item_code }}{% if item.container %}<br><span style=\"font-size:9px;\">{{ item.container }}</span>{% endif %}</span>\n                <span class=\"item-weight\">{{ \"%.2f\"|format(item.weight or 0) }} kg</span>\n            </div>\n            {% endfor %}\n            <div class=\"item-row\" style=\"border-top:1px dashed #000;margin-top:1mm;padding-top:1mm;\">\n                <span class=\"item-name\">\u0e23\u0e27\u0e21\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e14\u0e35</span>\n                <span class=\"item-weight\">{{ \"%.2f\"|format(doc.total_good_weight or 0) }} kg</span>\n            </div>\n        </div>\n        {% endif %}\n\n        <!-- Unwanted -->\n        {% if doc.unwanted_items %}\n        <div class=\"items-section\">\n            <div class=\"items-header\"><span>\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23 \u2022 Unwanted</span></div>\n            {% for item in doc.unwanted_items %}\n            <div class=\"item-row\">\n                <span class=\"item-name\">{{ item.item_name or item.item_code }}{% if item.return_reason %} <span style=\"font-size:9px;\">({{ item.return_reason }})</span>{% endif %}{% if item.container %}<br><span style=\"font-size:9px;\">{{ item.container }}</span>{% endif %}</span>\n                <span class=\"item-weight\">{{ \"%.2f\"|format(item.weight or 0) }} kg</span>\n            </div>\n            {% endfor %}\n            <div class=\"item-row\" style=\"border-top:1px dashed #000;margin-top:1mm;padding-top:1mm;\">\n                <span class=\"item-name\">\u0e23\u0e27\u0e21\u0e02\u0e2d\u0e07\u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23</span>\n                <span class=\"item-weight\">{{ \"%.2f\"|format(doc.total_unwanted_weight or 0) }} kg</span>\n            </div>\n        </div>\n        {% endif %}\n\n        <!-- Totals -->\n        <div class=\"total-section\">\n            <div class=\"total-row\">\n                <span>\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01\u0e23\u0e27\u0e21 / Sorted:</span>\n                <span class=\"total-weight\">{{ \"%.2f\"|format(doc.total_weight or 0) }} kg</span>\n            </div>\n            {% if doc.dropoff_total_weight %}\n            <div class=\"info-row\" style=\"font-size:10px;\">\n                <span>\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e23\u0e31\u0e1a\u0e40\u0e02\u0e49\u0e32 / Received:</span>\n                <span>{{ \"%.2f\"|format(doc.dropoff_total_weight) }} kg</span>\n            </div>\n            <div class=\"info-row\" style=\"font-size:10px;\">\n                <span>\u0e1c\u0e25\u0e15\u0e48\u0e32\u0e07 / Difference:</span>\n                <span>{{ \"%.2f\"|format((doc.dropoff_total_weight or 0) - (doc.total_weight or 0)) }} kg</span>\n            </div>\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- Footer -->\n    <div class=\"receipt-footer\">\n        <div class=\"operator-info\">\n            \u0e1c\u0e39\u0e49\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01: {{ frappe.db.get_value('User', doc.operator, 'full_name') or doc.operator or '-' }}\n        </div>\n        <div class=\"operator-info\">\n            \u0e1e\u0e34\u0e21\u0e1e\u0e4c\u0e40\u0e21\u0e37\u0e48\u0e2d: {{ frappe.utils.now_datetime().strftime('%d/%m/%Y %H:%M:%S') }}\n        </div>\n        <div class=\"thank-you\">\u0e02\u0e2d\u0e1a\u0e04\u0e38\u0e13\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49\u0e1a\u0e23\u0e34\u0e01\u0e32\u0e23</div>\n    </div>\n\n    <!-- QR Codes (Drop-off + Sorting) -->\n    <div class=\"qr-section\">\n        {% if doc.dropoff %}\n        <div class=\"qr-box\">\n            <img src=\"{{ qr_data_uri('Dropoff', doc.dropoff) }}\">\n            <div class=\"qr-label\">Drop-off</div>\n            <div class=\"qr-doc-id\">{{ doc.dropoff }}</div>\n        </div>\n        {% endif %}\n\n        <div class=\"qr-box\">\n            <img src=\"{{ qr_data_uri('Production Sorting', doc.name) }}\">\n            <div class=\"qr-label\">\u0e43\u0e1a\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01 / Sorting</div>\n            <div class=\"qr-doc-id\">{{ doc.name }}</div>\n        </div>\n    </div>\n\n    <div class=\"cut-line\">- - - - - - - - - - - - - - -</div>\n</div>\n",
