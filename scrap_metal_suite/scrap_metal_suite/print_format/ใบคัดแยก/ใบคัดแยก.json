{
 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2026-08-25 20:50:45.332790",
 "custom_format": 1,
 "default_print_language": "th",
 "disabled": 0,
 "doc_type": "Dropoff Final",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 0,
 "html": "<style>\n@page { size: A4; margin: 15mm; }\n\n.smt-receipt {\n    font-family: 'Sarabun', 'Tahoma', Arial, sans-serif;\n    font-size: 10pt;\n    color: #000;\n}\n\n.letter-head-wrapper {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 8mm;\n    padding-bottom: 5mm;\n    border-bottom: 1px solid #ccc;\n}\n.letter-head-left { text-align: left; }\n.letter-head-left img { max-height: 20mm; }\n.letter-head-right {\n    text-align: right;\n    font-size: 9pt;\n    line-height: 1.4;\n    color: #333;\n}\n.address-en { color: #666; font-size: 8pt; }\n\n.doc-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding-bottom: 5mm;\n    margin-bottom: 5mm;\n    border-bottom: 1px solid #000;\n}\n.doc-header-left { text-align: left; }\n.doc-header-right { text-align: right; }\n.doc-title { font-size: 16pt; font-weight: bold; }\n.doc-number { font-size: 12pt; }\n.status-badge {\n    display: inline-block;\n    padding: 1mm 4mm;\n    margin-top: 2mm;\n    font-weight: bold;\n    font-size: 9pt;\n}\n.status-open { border-bottom: 2px solid #004085; color: #004085; }\n.status-partially-settled { border-bottom: 2px solid #856404; color: #856404; }\n.status-fully-settled { border-bottom: 2px solid #155724; color: #155724; }\n.status-expired { border-bottom: 2px solid #721c24; color: #721c24; }\n.status-cancelled { border-bottom: 2px solid #721c24; color: #721c24; }\n.status-draft { border-bottom: 2px solid #666; color: #666; }\n.status-submitted { border-bottom: 2px solid #155724; color: #155724; }\n.status-unsettled { border-bottom: 2px solid #856404; color: #856404; }\n.status-settled { border-bottom: 2px solid #155724; color: #155724; }\n.status-verified { border-bottom: 2px solid #155724; color: #155724; }\n.status-needs-review { border-bottom: 2px solid #721c24; color: #721c24; }\n\n.section {\n    margin: 5mm 0;\n    padding-bottom: 3mm;\n    border-bottom: 1px dotted #ccc;\n}\n.section:last-of-type { border-bottom: none; }\n.section-header {\n    font-weight: bold;\n    font-size: 11pt;\n    margin-bottom: 3mm;\n    color: #333;\n}\n\n.info-row { display: flex; padding: 1mm 0; }\n.info-label { width: 35%; color: #666; font-size: 9pt; }\n.info-value { width: 65%; font-weight: 500; }\n.info-grid { display: flex; flex-wrap: wrap; }\n.info-grid .info-row { width: 50%; }\n\n.data-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 9pt;\n    margin: 2mm 0;\n}\n.data-table th {\n    text-align: left;\n    padding: 2mm 3mm;\n    border-bottom: 1px solid #000;\n    font-weight: bold;\n    font-size: 8pt;\n    color: #333;\n}\n.data-table td {\n    padding: 2mm 3mm;\n    border-bottom: 1px dotted #ddd;\n}\n.data-table tr:last-child td { border-bottom: none; }\n.data-table .text-right { text-align: right; }\n.data-table .total-row {\n    font-weight: bold;\n    border-top: 1px solid #000;\n    border-bottom: none;\n}\n.data-table .total-row td {\n    padding-top: 3mm;\n    border-bottom: none;\n}\n\n.signature-section {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 15mm;\n    padding-top: 5mm;\n}\n.signature-box { width: 40%; text-align: center; }\n.signature-line {\n    border-top: 1px solid #000;\n    margin-top: 25mm;\n    padding-top: 2mm;\n    font-size: 9pt;\n}\n\n.receipt-footer {\n    margin-top: 10mm;\n    padding-top: 3mm;\n    border-top: 1px solid #ccc;\n    font-size: 8pt;\n    color: #999;\n    display: flex;\n    justify-content: space-between;\n}\n\n.highlight-box {\n    padding: 3mm;\n    margin: 3mm 0;\n    border-left: 3px solid #004085;\n    background: #f8f9fa;\n}\n</style>\n{% if letter_head %}\n<div class=\"letter-head-wrapper\">\n    <div class=\"letter-head-left\">{{ letter_head }}</div>\n    <div class=\"letter-head-right\">\n        <div class=\"address-th\">88/88 \u0e16\u0e19\u0e19 \u0e1a\u0e32\u0e07\u0e1a\u0e31\u0e27\u0e17\u0e2d\u0e07 \u2013 \u0e2a\u0e38\u0e1e\u0e23\u0e23\u0e13\u0e1a\u0e38\u0e23\u0e35<br>\u0e15\u0e33\u0e1a\u0e25 \u0e2b\u0e19\u0e49\u0e32\u0e44\u0e21\u0e49 \u0e2d\u0e33\u0e40\u0e20\u0e2d\u0e25\u0e32\u0e14\u0e2b\u0e25\u0e38\u0e21\u0e41\u0e01\u0e49\u0e27<br>\u0e1b\u0e17\u0e38\u0e21\u0e18\u0e32\u0e19\u0e35 12140</div>\n        <div class=\"address-en\">88/88 Bang Bua Thong - Suphan Buri Rd,<br>Tambon Na Mai, Lat Lum Kaeo District,<br>Pathum Thani 12140</div>\n    </div>\n</div>\n{% endif %}\n\n<div class=\"smt-receipt\">\n    <div class=\"doc-header\">\n        <div class=\"doc-header-left\">\n            <div class=\"doc-title\">\u0e43\u0e1a\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01 / Sorting Report</div>\n        </div>\n        <div class=\"doc-header-right\">\n            <div class=\"doc-number\">{{ doc.name }}</div>\n            <div class=\"status-badge status-{{ doc.status|lower|replace(' ', '-') }}\">{{ doc.status }}</div>\n        </div>\n    </div>\n\n    <!-- General Info -->\n    <div class=\"section\">\n        <div class=\"section-header\">\u0e02\u0e49\u0e2d\u0e21\u0e39\u0e25\u0e17\u0e31\u0e48\u0e27\u0e44\u0e1b / General Information</div>\n        <div class=\"info-grid\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e43\u0e1a\u0e2a\u0e48\u0e07\u0e21\u0e2d\u0e1a / Dropoff</span>\n                <span class=\"info-value\">{{ doc.dropoff }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e1c\u0e39\u0e49\u0e02\u0e32\u0e22 / Supplier</span>\n                <span class=\"info-value\">{{ doc.supplier_name or doc.supplier }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e17\u0e30\u0e40\u0e1a\u0e35\u0e22\u0e19\u0e23\u0e16 / License Plate</span>\n                <span class=\"info-value\">{{ doc.license_plate or '-' }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a / Verification</span>\n                <span class=\"info-value\">\n                    <span class=\"status-badge status-{{ (doc.verification_status or 'pending')|lower|replace(' ', '-') }}\">\n                        {{ doc.verification_status or 'Pending' }}\n                    </span>\n                </span>\n            </div>\n            {% if doc.po_final %}\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e43\u0e1a\u0e2a\u0e31\u0e48\u0e07\u0e0b\u0e37\u0e49\u0e2d / Purchase Order</span>\n                <span class=\"info-value\">{{ doc.po_final }}</span>\n            </div>\n            {% endif %}\n        </div>\n    </div>\n\n    <!-- Good Items -->\n    {% if doc.good_items %}\n    <div class=\"section\">\n        <div class=\"section-header\">\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e14\u0e35 / Good Items</div>\n        <table class=\"data-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:5%\">#</th>\n                    <th style=\"width:45%\">\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 / Item</th>\n                    <th style=\"width:20%\">\u0e2b\u0e19\u0e48\u0e27\u0e22 / UOM</th>\n                    <th style=\"width:30%\" class=\"text-right\">\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01 / Weight (kg)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.good_items %}\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ item.item_name or item.item_code }}</td>\n                    <td>{{ item.uom or 'Kg' }}</td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(item.weight or 0) }}</td>\n                </tr>\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"3\" class=\"text-right\">\u0e23\u0e27\u0e21\u0e2a\u0e34\u0e19\u0e04\u0e49\u0e32\u0e14\u0e35 / Good Total</td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(doc.total_good_weight or 0) }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    <!-- Unwanted Items -->\n    {% if doc.unwanted_items %}\n    <div class=\"section\">\n        <div class=\"section-header\">\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23 / Unwanted Items</div>\n        <table class=\"data-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:5%\">#</th>\n                    <th style=\"width:30%\">\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 / Item</th>\n                    <th style=\"width:25%\">\u0e40\u0e2b\u0e15\u0e38\u0e1c\u0e25 / Reason</th>\n                    <th style=\"width:15%\">\u0e2b\u0e19\u0e48\u0e27\u0e22 / UOM</th>\n                    <th style=\"width:25%\" class=\"text-right\">\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01 / Weight (kg)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.unwanted_items %}\n                <tr>\n                    <td>{{ loop.index }}</td>\n                    <td>{{ item.item_name or item.item_code }}</td>\n                    <td>{{ item.return_reason or '-' }}</td>\n                    <td>{{ item.uom or 'Kg' }}</td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(item.weight or 0) }}</td>\n                </tr>\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"4\" class=\"text-right\">\u0e23\u0e27\u0e21\u0e02\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e44\u0e21\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23 / Unwanted Total</td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(doc.total_unwanted_weight or 0) }}</td>\n                </tr>\n            </tbody>\n        </table>\n    </div>\n    {% endif %}\n\n    <!-- Container Detail: received vs sorted, per bag -->\n    {% if doc.container_items %}\n    <div class=\"section\">\n        <div class=\"section-header\">\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14\u0e16\u0e38\u0e07 / Container Detail (\u0e23\u0e31\u0e1a\u0e40\u0e02\u0e49\u0e32 \u2192 \u0e04\u0e31\u0e14\u0e41\u0e22\u0e01)</div>\n        <table class=\"data-table\">\n            <thead>\n                <tr>\n                    <th style=\"width:16%\">\u0e16\u0e38\u0e07 / Container</th>\n                    <th style=\"width:20%\">\u0e23\u0e31\u0e1a\u0e40\u0e02\u0e49\u0e32 / Received</th>\n                    <th style=\"width:12%\" class=\"text-right\">\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e23\u0e31\u0e1a / In (kg)</th>\n                    <th style=\"width:20%\">\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01\u0e40\u0e1b\u0e47\u0e19 / Sorted To</th>\n                    <th style=\"width:12%\" class=\"text-right\">\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e04\u0e31\u0e14 / Out (kg)</th>\n                    <th style=\"width:20%\">\u0e1c\u0e25 / Outcome</th>\n                </tr>\n            </thead>\n            <tbody>\n                {%- set ns = namespace(seen=[], received_total=0, sorted_total=0) -%}\n                {% for row in doc.container_items %}\n                {#- A container is counted once, tracked by identity rather than\n                    by adjacency: its Good and Unwanted rows are not necessarily\n                    neighbours, and comparing against the previous row alone\n                    counted every bag twice. -#}\n                {%- set first = row.container not in ns.seen -%}\n                {%- if first -%}\n                    {%- set ns.seen = ns.seen + [row.container] -%}\n                    {%- set ns.received_total = ns.received_total + (row.received_weight or 0) -%}\n                {%- endif -%}\n                {%- set ns.sorted_total = ns.sorted_total + (row.sorted_weight or 0) -%}\n                <tr>\n                    <td>{% if first %}{{ row.container }}{% if row.container_type %}<br><span style=\"font-size:9px;color:#666\">{{ row.container_type }}</span>{% endif %}{% endif %}</td>\n                    <td>{% if first %}{{ row.received_item_name or row.received_item_code or '' }}{% endif %}</td>\n                    <td class=\"text-right\">{% if first %}{{ \"{:,.3f}\".format(row.received_weight or 0) }}{% endif %}</td>\n                    <td>{{ row.sorted_item_name or row.sorted_item_code or '' }}</td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(row.sorted_weight or 0) }}</td>\n                    <td>{{ row.classification or '' }}{% if row.return_reason %} \u2014 {{ row.return_reason }}{% endif %}</td>\n                </tr>\n                {% endfor %}\n                <tr class=\"total-row\">\n                    <td colspan=\"2\" class=\"text-right\">\u0e23\u0e27\u0e21 / Total</td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(ns.received_total) }}</td>\n                    <td></td>\n                    <td class=\"text-right\">{{ \"{:,.3f}\".format(ns.sorted_total) }}</td>\n                    <td>{% if (ns.received_total - ns.sorted_total)|abs > 0.0005 %}\u0e1c\u0e25\u0e15\u0e48\u0e32\u0e07 / Diff {{ \"{:,.3f}\".format(ns.received_total - ns.sorted_total) }}{% endif %}</td>\n                </tr>\n            </tbody>\n        </table>\n        <div style=\"font-size:9px;color:#666;margin-top:4px\">\n            \u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e23\u0e31\u0e1a\u0e40\u0e02\u0e49\u0e32\u0e41\u0e2a\u0e14\u0e07\u0e04\u0e23\u0e31\u0e49\u0e07\u0e40\u0e14\u0e35\u0e22\u0e27\u0e15\u0e48\u0e2d\u0e16\u0e38\u0e07 / Received weight is shown once per container \u2014 one bag may sort into several grades.\n        </div>\n    </div>\n    {% endif %}\n\n\n    <!-- Variance Summary -->\n    <div class=\"section\">\n        <div class=\"section-header\">\u0e2a\u0e23\u0e38\u0e1b\u0e04\u0e48\u0e32\u0e40\u0e1a\u0e35\u0e48\u0e22\u0e07\u0e40\u0e1a\u0e19 / Variance Summary</div>\n        <div class=\"info-grid\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e08\u0e32\u0e01 Dropoff</span>\n                <span class=\"info-value\">{{ \"{:,.3f}\".format(doc.dropoff_total_weight or 0) }} kg</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e19\u0e49\u0e33\u0e2b\u0e19\u0e31\u0e01\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a\u0e23\u0e27\u0e21 / Verified Total</span>\n                <span class=\"info-value\">{{ \"{:,.3f}\".format(doc.total_verified_weight or 0) }} kg</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e04\u0e48\u0e32\u0e40\u0e1a\u0e35\u0e48\u0e22\u0e07\u0e40\u0e1a\u0e19 / Variance</span>\n                <span class=\"info-value\">{{ \"{:,.3f}\".format(doc.weight_variance or 0) }} kg ({{ \"{:.2f}\".format(doc.variance_percent or 0) }}%)</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">\u0e1c\u0e25\u0e01\u0e32\u0e23\u0e15\u0e23\u0e27\u0e08 / Result</span>\n                <span class=\"info-value\">\n                    {% if doc.variance_ok %}\u2713 \u0e1c\u0e48\u0e32\u0e19 / Pass{% else %}\u2717 \u0e44\u0e21\u0e48\u0e1c\u0e48\u0e32\u0e19 / Fail{% endif %}\n                </span>\n            </div>\n        </div>\n    </div>\n\n    <!-- Signatures -->\n    <div class=\"signature-section\">\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">\u0e1c\u0e39\u0e49\u0e04\u0e31\u0e14\u0e41\u0e22\u0e01 / Sorter</div>\n        </div>\n        <div class=\"signature-box\">\n            <div class=\"signature-line\">\u0e1c\u0e39\u0e49\u0e15\u0e23\u0e27\u0e08\u0e2a\u0e2d\u0e1a / Reviewer</div>\n        </div>\n    </div>\n\n    <div class=\"receipt-footer\">\n    <span>\u0e1e\u0e34\u0e21\u0e1e\u0e4c\u0e40\u0e21\u0e37\u0e48\u0e2d / Printed: {{ frappe.utils.now_datetime().strftime('%d/%m/%Y %H:%M') }}</span>\n    <span>{{ frappe.session.user }}</span>\n</div>\n</div>",
