[
  {
    "doctype": "Print Format",
    "name": "Scrap Weight Thermal",
    "doc_type": "Scrap Weight",
    "module": "Scrap Metal Suite",
    "standard": "Yes",
    "default_print_format": 1,
    "custom_format": 1,
    "print_format_type": "Jinja",
    "default_print_language": "th",
    "html": "<style>\n@page {\n    size: 80mm auto;\n    margin: 2mm;\n}\n\n.thermal-receipt {\n    font-family: 'Sarabun', 'Tahoma', sans-serif;\n    font-size: 12px;\n    width: 76mm;\n    margin: 0 auto;\n    padding: 2mm;\n    color: #000;\n}\n\n.receipt-header {\n    text-align: center;\n    border-bottom: 1px dashed #000;\n    padding-bottom: 3mm;\n    margin-bottom: 3mm;\n}\n\n.qr-section {\n    display: flex;\n    justify-content: space-around;\n    margin-bottom: 3mm;\n}\n\n.qr-box {\n    text-align: center;\n}\n\n.qr-box img {\n    width: 25mm;\n    height: 25mm;\n}\n\n.qr-label {\n    font-size: 9px;\n    margin-top: 1mm;\n}\n\n.company-name {\n    font-size: 16px;\n    font-weight: bold;\n    margin: 2mm 0;\n}\n\n.company-address {\n    font-size: 8px;\n    margin: 1mm 0;\n}\n\n.doc-title {\n    font-size: 14px;\n    font-weight: bold;\n    margin: 2mm 0;\n}\n\n.doc-number {\n    font-size: 11px;\n    color: #333;\n}\n\n.receipt-body {\n    margin: 2mm 0;\n}\n\n.info-section {\n    border-bottom: 1px dashed #000;\n    padding-bottom: 2mm;\n    margin-bottom: 2mm;\n}\n\n.info-row {\n    display: flex;\n    justify-content: space-between;\n    margin: 1mm 0;\n    font-size: 11px;\n}\n\n.info-label {\n    color: #333;\n}\n\n.info-value {\n    font-weight: bold;\n    text-align: right;\n}\n\n.items-section {\n    margin: 3mm 0;\n}\n\n.items-header {\n    font-weight: bold;\n    font-size: 11px;\n    border-bottom: 1px solid #000;\n    padding-bottom: 1mm;\n    margin-bottom: 1mm;\n}\n\n.item-row {\n    display: flex;\n    justify-content: space-between;\n    padding: 1mm 0;\n    font-size: 11px;\n    border-bottom: 1px dotted #ccc;\n}\n\n.item-name {\n    flex: 1;\n}\n\n.item-weight {\n    text-align: right;\n    font-weight: bold;\n    min-width: 20mm;\n}\n\n.total-section {\n    border-top: 2px solid #000;\n    margin-top: 2mm;\n    padding-top: 2mm;\n}\n\n.total-row {\n    display: flex;\n    justify-content: space-between;\n    font-size: 14px;\n    font-weight: bold;\n}\n\n.total-weight {\n    font-size: 18px;\n}\n\n.reweight-badge {\n    border: 2px solid #000;\n    padding: 1mm 2mm;\n    font-size: 11px;\n    font-weight: bold;\n    text-align: center;\n    margin: 2mm 0;\n}\n\n.remarks-section {\n    border-top: 1px dashed #000;\n    margin-top: 2mm;\n    padding-top: 2mm;\n    font-size: 10px;\n}\n\n.receipt-footer {\n    border-top: 1px dashed #000;\n    margin-top: 3mm;\n    padding-top: 2mm;\n    text-align: center;\n    font-size: 9px;\n    color: #666;\n}\n\n.operator-info {\n    margin: 1mm 0;\n}\n\n.thank-you {\n    font-size: 11px;\n    font-weight: bold;\n    margin-top: 2mm;\n}\n\n.cut-line {\n    border-top: 1px dashed #000;\n    margin-top: 3mm;\n    text-align: center;\n    font-size: 8px;\n    color: #999;\n}\n</style>\n\n<div class=\"thermal-receipt\">\n    <!-- QR Codes Section -->\n    <div class=\"receipt-header\">\n        <div class=\"qr-section\">\n            {% if doc.pos_order %}\n            <div class=\"qr-box\">\n                <img src=\"{{ qr_src('POS Order', doc.pos_order) }}\">\n                <div class=\"qr-label\">ใบคิว</div>\n            </div>\n            {% endif %}\n            <div class=\"qr-box\">\n                <img src=\"{{ qr_src(doc.doctype, doc.name) }}\">\n                <div class=\"qr-label\">ใบชั่ง</div>\n            </div>\n        </div>\n\n        <!-- Company Name -->\n        <div class=\"company-name\">Scrap Metal Trading</div>\n        <div class=\"company-address\">88/88 หมู่ 1 ตำบลท่าไม้ อำเภอลาดหลุมแก้ว จังหวัดปทุมธานี</div>\n\n        <!-- Document Title -->\n        <div class=\"doc-title\">ใบชั่งน้ำหนัก{% if doc.is_reweight %} (ชั่งซ้ำ){% endif %}</div>\n        <div class=\"doc-number\">เลขที่: {{ doc.name }}</div>\n    </div>\n\n    <!-- Body -->\n    <div class=\"receipt-body\">\n        <!-- Date/Time Info -->\n        <div class=\"info-section\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">วันที่:</span>\n                <span class=\"info-value\">{{ doc.posting_date }}</span>\n            </div>\n            <div class=\"info-row\">\n                <span class=\"info-label\">เวลา:</span>\n                <span class=\"info-value\">{{ doc.posting_time }}</span>\n            </div>\n            {% if doc.pos_order %}\n            <div class=\"info-row\">\n                <span class=\"info-label\">ใบคิว:</span>\n                <span class=\"info-value\">{{ doc.pos_order }}</span>\n            </div>\n            {% endif %}\n        </div>\n\n        <!-- Supplier Info -->\n        <div class=\"info-section\">\n            <div class=\"info-row\">\n                <span class=\"info-label\">ผู้ขาย:</span>\n                <span class=\"info-value\">{{ doc.supplier_name or doc.supplier }}</span>\n            </div>\n        </div>\n\n        <!-- Reweight Info -->\n        {% if doc.is_reweight %}\n        <div class=\"reweight-badge\">\n            ** ชั่งซ้ำ **\n            {% if doc.reweight_reason %}<br>{{ doc.reweight_reason }}{% endif %}\n        </div>\n        {% endif %}\n\n        <!-- Items -->\n        <div class=\"items-section\">\n            <div class=\"items-header\">\n                <span>รายการ</span>\n            </div>\n            {% for item in doc.items %}\n            <div class=\"item-row\">\n                <span class=\"item-name\">{{ item.item_name or item.item_code }}</span>\n                <span class=\"item-weight\">{{ \"%.2f\"|format(item.weight) }} {{ item.uom or 'Kg' }}</span>\n            </div>\n            {% endfor %}\n        </div>\n\n        <!-- Total -->\n        <div class=\"total-section\">\n            <div class=\"total-row\">\n                <span>น้ำหนักรวม:</span>\n                <span class=\"total-weight\">{{ \"%.2f\"|format(doc.total_weight) }} Kg</span>\n            </div>\n        </div>\n\n        <!-- Remarks -->\n        {% if doc.remarks %}\n        <div class=\"remarks-section\">\n            <strong>หมายเหตุ:</strong> {{ doc.remarks }}\n        </div>\n        {% endif %}\n    </div>\n\n    <!-- Footer -->\n    <div class=\"receipt-footer\">\n        <div class=\"operator-info\">\n            ผู้ชั่ง: {{ frappe.db.get_value('User', doc.operator, 'full_name') or doc.operator or '-' }}\n        </div>\n        {% if doc.scale %}\n        <div class=\"operator-info\">\n            เครื่องชั่ง: {{ frappe.db.get_value('Scale', doc.scale, 'scale_name') or doc.scale }}\n        </div>\n        {% endif %}\n        <div class=\"operator-info\">\n            พิมพ์เมื่อ: {{ frappe.utils.now_datetime().strftime('%d/%m/%Y %H:%M') }}\n        </div>\n        <div class=\"thank-you\">ขอบคุณที่ใช้บริการ</div>\n    </div>\n\n    <div class=\"cut-line\">- - - - - - - - - - - - - - -</div>\n</div>"
  }
]