{% extends "templates/web.html" %}

{% block title %}Production Sorting{% endblock %}

{% block head_include %}
<link rel="stylesheet" href="/assets/scrap_metal_suite/css/pos.css">
<link rel="stylesheet" href="/assets/scrap_metal_suite/css/production-theme.css">
<script src="/assets/scrap_metal_suite/js/pos-translations.js"></script>
<script src="/assets/scrap_metal_suite/js/scale_reader.js"></script>
{% endblock %}

{% block style %}
<style>
/* Hide Frappe navigation for fullscreen */
.navbar, .web-footer, .footer, footer, .page-header, .page-head, header.navbar {
    display: none !important;
}
html, body {
    margin: 0 !important;
    padding: 0 !important;
    overflow-x: hidden;
}
body {
    padding-top: 0 !important;
    background: #1a1a2e;
}
.main-section, .container, .web-content, .page-content, main, .page-container {
    padding: 0 !important;
    margin: 0 !important;
    max-width: 100% !important;
}
</style>
{% endblock %}

{% block page_content %}
<div class="production-container" id="productionContainer">
    {% if error %}
    <div class="pos-error">
        <div class="error-icon">⚠️</div>
        <h2>Access Denied</h2>
        <p>{{ error }}</p>
        <a href="/pos" class="btn-pos">Back to POS</a>
    </div>
    {% else %}
    <!-- Header -->
    <header class="production-header">
        <div class="header-left">
            <a href="/pos" class="btn-back-small">&#8592;</a>
            <span class="brand-badge">X-DESK</span>
            {% if active_session %}
            <span class="session-badge">{{ active_session.name }}</span>
            {% else %}
            <span class="session-badge">No Session</span>
            {% endif %}
            <span class="operator-name">{{ operator_name }}</span>
        </div>
        <div class="header-center">
            <h1>&#128295; Production Sorting</h1>
        </div>
        <div class="header-right">
            {% if active_session %}
            <button class="btn-header btn-danger" onclick="confirmCloseSession()">Close Session</button>
            {% else %}
            <button class="btn-header btn-primary" onclick="startSession()">Start Session</button>
            {% endif %}
        </div>
    </header>

    <!-- Main Content -->
    <div class="production-body">
        <!-- Session Setup (shown when no session) -->
        <div id="sessionSetup" class="session-setup" {% if active_session %}style="display:none;"{% endif %}>
            <div class="setup-card">
                <h2>Start Production Session</h2>
                <p>Scan a scale QR code or select from list</p>
                <div class="scale-list">
                    {% for scale in scales %}
                    <button class="scale-option" onclick="selectScale('{{ scale.name }}', '{{ scale.scale_name }}')">
                        <span class="scale-icon">&#9878;</span>
                        <div class="scale-info">
                            <span class="scale-name">{{ scale.scale_name }}</span>
                            <span class="scale-location">{{ scale.location or '' }}</span>
                        </div>
                    </button>
                    {% endfor %}
                </div>
            </div>
        </div>

        <!-- Sorting Interface (shown when session active) -->
        <div id="sortingInterface" class="sorting-interface" {% if not active_session %}style="display:none;"{% endif %}>
            <!-- Left Panel - Dropoff Selection -->
            <div class="panel panel-dropoff">
                <div class="panel-header">
                    <h3>Select Dropoff</h3>
                </div>
                <div class="dropoff-search">
                    <input type="text" id="dropoffSearch" placeholder="Enter Dropoff ID..."
                           oninput="searchDropoff(this.value)" autocomplete="off">
                    <div id="dropoffResults" class="search-results"></div>
                </div>
                <div id="dropoffDetails" class="dropoff-details" style="display:none;">
                    <div class="detail-row">
                        <span class="label">Dropoff ID:</span>
                        <span class="value" id="currentDropoffId"></span>
                    </div>
                    <div class="detail-row">
                        <span class="label">Supplier:</span>
                        <span class="value" id="currentDropoffSupplier"></span>
                    </div>
                    <div class="detail-row">
                        <span class="label">Total Weight:</span>
                        <span class="value" id="currentDropoffWeight"></span>
                    </div>
                    <button class="btn-clear" onclick="clearDropoff()">Clear</button>
                </div>
            </div>

            <!-- Middle Panel - Item Weighing -->
            <div class="panel panel-weighing">
                <div class="panel-header">
                    <h3>Weigh Items</h3>
                </div>

                <!-- Weight Display -->
                <div class="weight-display">
                    <div class="weight-value" id="weightValue">0.000</div>
                    <div class="weight-unit">kg</div>
                </div>

                <!-- Item Type Tabs -->
                <div class="item-tabs">
                    <button class="item-tab active" data-type="good" onclick="switchItemType('good')">
                        Good Items (Keep & Pay)
                    </button>
                    <button class="item-tab" data-type="unwanted" onclick="switchItemType('unwanted')">
                        Unwanted Items (Return)
                    </button>
                </div>

                <!-- Item Selection -->
                <div class="item-selection">
                    <label>Select Item:</label>
                    <select id="itemSelect" onchange="selectItem()">
                        <option value="">-- Choose Item --</option>
                        {% for item in production_items %}
                        <option value="{{ item.item_code }}" data-uom="{{ item.uom }}">
                            {{ item.item_name }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <!-- Return Reason (for unwanted items) -->
                <div id="returnReasonSection" class="return-reason-section" style="display:none;">
                    <label>Return Reason:</label>
                    <select id="returnReason">
                        <option value="Contamination">Contamination</option>
                        <option value="Wrong Material">Wrong Material</option>
                        <option value="Packaging">Packaging</option>
                        <option value="Dirt/Debris">Dirt/Debris</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <!-- Remarks -->
                <div class="remarks-section">
                    <label>Remarks (Optional):</label>
                    <input type="text" id="remarks" placeholder="Notes...">
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button class="btn-action btn-weight" onclick="captureWeight()">
                        &#9878; Capture Weight
                    </button>
                    <button class="btn-action btn-add" onclick="addItem()" id="addItemBtn" disabled>
                        &#10010; Add Item
                    </button>
                </div>
            </div>

            <!-- Right Panel - Current Sorting -->
            <div class="panel panel-sorting">
                <div class="panel-header">
                    <h3>Current Sorting</h3>
                </div>

                <!-- Sorting Summary -->
                <div class="sorting-summary">
                    <div class="summary-row good">
                        <span class="summary-label">Good Items:</span>
                        <span class="summary-value" id="goodTotal">0.000 kg</span>
                    </div>
                    <div class="summary-row unwanted">
                        <span class="summary-label">Unwanted:</span>
                        <span class="summary-value" id="unwantedTotal">0.000 kg</span>
                    </div>
                    <div class="summary-row total">
                        <span class="summary-label">Total Sorted:</span>
                        <span class="summary-value" id="totalSorted">0.000 kg</span>
                    </div>
                    <div class="summary-row variance" id="varianceRow" style="display:none;">
                        <span class="summary-label">Variance:</span>
                        <span class="summary-value" id="varianceValue"></span>
                    </div>
                </div>

                <!-- Items List -->
                <div class="items-list" id="itemsList">
                    <!-- Dynamically populated -->
                </div>

                <!-- Submit Button -->
                <div class="submit-section">
                    <button class="btn-submit" onclick="submitSorting()" id="submitBtn" disabled>
                        Submit Sorting
                    </button>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<script src="/assets/scrap_metal_suite/js/production-terminal.js"></script>
{% endblock %}
